{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/download",
      "destination": "/TuitionManager.apk",
      "permanent": false
    },
    {
      "source": "/download/tuition",
      "destination": "/TuitionManager.apk",
      "permanent": false
    },
    {
      "source": "/tuitionmanager.apk",
      "destination": "/TuitionManager.apk",
      "permanent": false
    },
    {
      "source": "/tuition.apk",
      "destination": "/TuitionManager.apk",
      "permanent": false
    },
    {
      "source": "/app.apk",
      "destination": "/TuitionManager.apk",
      "permanent": false
    },
    {
      "source": "/apk",
      "destination": "/TuitionManager.apk",
      "permanent": false
    },
    {
      "source": "/download/downloader",
      "destination": "/KMB_Downloader.apk",
      "permanent": false
    },
    {
      "source": "/kmb_downloader.apk",
      "destination": "/KMB_Downloader.apk",
      "permanent": false
    },
    {
      "source": "/downloader.apk",
      "destination": "/KMB_Downloader.apk",
      "permanent": false
    },
    {
      "source": "/download/qalbi",
      "destination": "/Qalbi-Release.apk",
      "permanent": false
    },
    {
      "source": "/qalbi.apk",
      "destination": "/Qalbi-Release.apk",
      "permanent": false
    },
    {
      "source": "/download/getcarout",
      "destination": "/GetCarOut.apk",
      "permanent": false
    },
    {
      "source": "/getcarout.apk",
      "destination": "/GetCarOut.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
