import 'dart:async';
import 'dart:convert';
import 'dart:io';
import 'dart:math';
import 'package:flutter/material.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'dart:typed_data';
import 'dart:ui' as ui;
import 'package:flutter/rendering.dart';
import 'package:image_picker/image_picker.dart';
import 'package:pdf/pdf.dart';
import 'package:pdf/widgets.dart' as pw;
import 'package:printing/printing.dart';
import 'package:firebase_core/firebase_core.dart';
import 'package:firebase_messaging/firebase_messaging.dart';
import 'package:supabase_flutter/supabase_flutter.dart';
import 'package:url_launcher/url_launcher.dart';
import 'config.dart';
import 'firebase_options.dart';

bool pushReady = false;

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  if (Cfg.ready) {
    await Supabase.initialize(url: Cfg.url, anonKey: Cfg.anonKey);
    try {
      await Firebase.initializeApp(options: DefaultFirebaseOptions.currentPlatform);
      pushReady = true;
    } catch (_) {}
  }
  runApp(const TuitionApp());
}

String newCode() {
  const c = 'abcdefghjkmnpqrstuvwxyz23456789';
  final r = Random.secure();
  return List.generate(8, (_) => c[r.nextInt(c.length)]).join();
}

class Student {
  final String id, name, phone, code;
  final String? batchId;
  final int fee;
  Student(this.id, this.name, this.phone, this.fee, this.code, {this.batchId});
  Map<String, dynamic> toJson() => {
        'id': id,
        'name': name,
        'phone': phone,
        'fee': fee,
        'code': code,
        'batchId': batchId
      };
  factory Student.fromJson(Map<String, dynamic> j) => Student(
      j['id'], j['name'], j['phone'], j['fee'], j['code'] ?? newCode(),
      batchId: j['batchId']);
}

class Store extends ChangeNotifier {
  String center = 'میرا ٹیوشن سینٹر';
  final List<Student> students = [];
  final Map<String, Map<String, bool>> att = {};
  final Map<String, Map<String, bool>> paid = {};
  final Map<String, Map<String, int>> pays = {};
  final Map<String, String> notes = {};
  final List<Map<String, String>> notices = [];
  final List<Map<String, dynamic>> batches = [];
  final List<Map<String, dynamic>> tests = [];
  final List<Map<String, dynamic>> ledger = [];
  final List<Map<String, dynamic>> homework = [];
  final Map<String, String> profile = {};
  SharedPreferences? _p;

  String get today => DateTime.now().toIso8601String().substring(0, 10);
  String get month => today.substring(0, 7);

  Future<void> load() async {
    _p = await SharedPreferences.getInstance();
    final raw = _p!.getString('tuition_v1');
    if (raw == null) return;
    _apply(jsonDecode(raw) as Map<String, dynamic>);
    _save();
  }

  void _apply(Map<String, dynamic> j) {
    center = j['center'] ?? center;
    students
      ..clear()
      ..addAll((j['students'] as List)
          .map((e) => Student.fromJson(Map<String, dynamic>.from(e))));
    att.clear();
    (j['att'] as Map).forEach((d, m) => att[d] = Map<String, bool>.from(m));
    paid.clear();
    (j['paid'] as Map).forEach((d, m) => paid[d] = Map<String, bool>.from(m));
    notes
      ..clear()
      ..addAll(Map<String, String>.from(j['notes']));
    notices
      ..clear()
      ..addAll(((j['notices'] ?? []) as List)
          .map((e) => Map<String, String>.from(e)));
    List<Map<String, dynamic>> list(String k) => ((j[k] ?? []) as List)
        .map((e) => Map<String, dynamic>.from(e))
        .toList();
    batches
      ..clear()
      ..addAll(list('batches'));
    tests
      ..clear()
      ..addAll(list('tests'));
    ledger
      ..clear()
      ..addAll(list('ledger'));
    homework
      ..clear()
      ..addAll(list('homework'));
    profile
      ..clear()
      ..addAll(Map<String, String>.from(j['profile'] ?? {}));
    pays.clear();
    ((j['pays'] ?? {}) as Map).forEach((m, v) {
      pays[m] = Map<String, int>.from(v);
    });
  }

  void _save() {
    _p?.setString('tuition_v1', jsonEncode(toMap()));
    notifyListeners();
    _autoSync();
  }

  Map<String, dynamic> toMap() => {
        'center': center,
        'students': students.map((s) => s.toJson()).toList(),
        'att': att,
        'paid': paid,
        'notes': notes,
        'notices': notices,
        'batches': batches,
        'tests': tests,
        'ledger': ledger,
        'homework': homework,
        'profile': profile,
        'pays': pays,
      };

  Timer? _timer;
  String syncStatus = '';
  bool get _loggedIn =>
      Cfg.ready && Supabase.instance.client.auth.currentUser != null;

  // ہر تبدیلی کے 3 سیکنڈ بعد خود بخود سنک اور بیک اپ
  void _autoSync() {
    if (!_loggedIn) return;
    _timer?.cancel();
    _timer = Timer(const Duration(seconds: 3), () async {
      syncStatus = await sync();
      notifyListeners();
    });
  }

  Future<String> restore() async {
    if (!_loggedIn) return 'پہلے لاگ اِن کریں';
    try {
      final r = await Supabase.instance.client
          .from('backups')
          .select('data')
          .maybeSingle();
      if (r == null) return 'کوئی بیک اپ نہیں ملا';
      _apply(Map<String, dynamic>.from(r['data']));
      _save();
      return 'بحال ہو گیا: ${students.length} طلبہ';
    } catch (e) {
      return 'بحالی ناکام: $e';
    }
  }

  void addStudent(String name, String phone, int fee, [String? batchId]) {
    students.add(Student(
        's${DateTime.now().microsecondsSinceEpoch}', name, phone, fee, newCode(),
        batchId: batchId));
    _save();
  }

  void delStudent(String id) {
    final st = students.firstWhere((s) => s.id == id);
    students.removeWhere((s) => s.id == id);
    if (Cfg.ready && Supabase.instance.client.auth.currentUser != null) {
      Supabase.instance.client
          .from('snapshots')
          .delete()
          .eq('code', st.code)
          .then((_) {}, onError: (_) {});
    }
    _save();
  }

  void setAtt(String id, bool v) {
    att.putIfAbsent(today, () => {})[id] = v;
    _save();
  }

  bool? attToday(String id) => att[today]?[id];
  bool isPaid(String id) => paid[month]?[id] ?? false;

  // مہینے کی واجب فیس: بھائی بہن (ایک ہی فون نمبر) کے دوسرے بچوں پر رعایت
  int dueOf(String id) {
    final i = students.indexWhere((x) => x.id == id);
    if (i < 0) return 0;
    final st = students[i];
    var d = st.fee;
    final pct = int.tryParse(profile['sibling'] ?? '') ?? 0;
    if (pct > 0 && st.phone.trim().isNotEmpty) {
      final dup = students.sublist(0, i).any((x) => x.phone.trim() == st.phone.trim());
      if (dup) d = (d * (100 - pct) / 100).round();
    }
    return d;
  }

  int remaining(String id) =>
      isPaid(id) ? 0 : max(0, dueOf(id) - (pays[month]?[id] ?? 0));

  int receivedTotal() => students.fold<int>(
      0, (a, x) => a + (isPaid(x.id) ? dueOf(x.id) : (pays[month]?[x.id] ?? 0)));

  void togglePaid(String id) {
    final m = paid.putIfAbsent(month, () => {});
    final now = !(m[id] ?? false);
    m[id] = now;
    if (now) {
      pays.putIfAbsent(month, () => {})[id] = dueOf(id);
    } else {
      pays[month]?.remove(id);
    }
    _save();
  }

  void addPayment(String id, int amount) {
    final m = pays.putIfAbsent(month, () => {});
    m[id] = (m[id] ?? 0) + amount;
    if (m[id]! >= dueOf(id)) paid.putIfAbsent(month, () => {})[id] = true;
    _save();
  }

  String feeReminder(Student s) =>
      'السلام علیکم! ${s.name} کی $month کی فیس ${remaining(s.id)} روپے باقی ہے۔ براہِ کرم ادا فرما دیں۔ شکریہ\n$center';

  void setNote(String t) {
    notes[today] = t;
    _save();
  }

  void setCenter(String t) {
    center = t;
    _save();
  }

  int presentDays(String id) => att.entries
      .where((e) => e.key.startsWith(month) && e.value[id] == true)
      .length;
  int markedDays(String id) => att.entries
      .where((e) => e.key.startsWith(month) && e.value.containsKey(id))
      .length;

  String message(Student s) {
    final a = attToday(s.id);
    final status = a == true
        ? 'حاضر تھا/تھی۔'
        : a == false
            ? 'غیر حاضر تھا/تھی۔'
            : '-';
    final note = notes[today];
    final fee = isPaid(s.id) ? 'ادا ہو چکی ✅' : 'باقی ہے - ${remaining(s.id)} روپے';
    var t = 'السلام علیکم! $center\n${s.name} آج $status\n';
    if (note != null && note.isNotEmpty) t += 'آج کا سبق: $note\n';
    t += 'فیس ($month): $fee\n\nلائیو ریکارڈ کے لیے ایپ انسٹال کریں اور یہ کوڈ ڈالیں: ${s.code}';
    return t;
  }

  void addHomework(String url, String path, String batch) {
    homework.add({'id': _id(), 'd': today, 'url': url, 'path': path, 'batch': batch});
    if (homework.length > 10) homework.removeAt(0);
    _save();
  }

  void delHomework(String id) {
    final h = homework.firstWhere((x) => x['id'] == id);
    homework.removeWhere((x) => x['id'] == id);
    if (_loggedIn) {
      Supabase.instance.client.storage
          .from('homework')
          .remove(['${h['path']}']).then((_) {}, onError: (_) {});
    }
    _save();
  }

  List<Map<String, dynamic>> hwFor(Student s) => homework.reversed
      .where((h) => (h['batch'] ?? '') == '' || h['batch'] == s.batchId)
      .take(3)
      .map((h) => {'url': h['url'], 'd': h['d']})
      .toList();

  // [کل دن جن میں حاضری لگی، حاضر دن] پچھلے 7 دن
  List<int> weekStats(String id) {
    final cs = DateTime.now()
        .subtract(const Duration(days: 6))
        .toIso8601String()
        .substring(0, 10);
    var m = 0, pr = 0;
    att.forEach((d, mp) {
      if (d.compareTo(cs) >= 0 && mp.containsKey(id)) {
        m++;
        if (mp[id] == true) pr++;
      }
    });
    return [m, pr];
  }

  String weeklyMessage(Student s) {
    final w = weekStats(s.id);
    final ts = testsFor(s)
        .take(3)
        .map((x) => '${x['name']} ${x['got']}/${x['total']}')
        .join('، ');
    final fee = isPaid(s.id) ? 'ادا ✅' : 'باقی ${remaining(s.id)} روپے';
    final tl = ts.isEmpty ? '' : 'ٹیسٹ: $ts\n';
    return 'السلام علیکم! ${s.name} کا ہفتہ وار خلاصہ:\nحاضری: ${w[0]} میں سے ${w[1]} دن\n${tl}فیس: $fee\n$center';
  }

  Map<String, dynamic>? batchOf(Student s) {
    for (final b in batches) {
      if (b['id'] == s.batchId) return b;
    }
    return null;
  }

  List<Map<String, dynamic>> testsFor(Student s) {
    final out = <Map<String, dynamic>>[];
    for (final t in tests.reversed) {
      final b = t['batch'] ?? '';
      if (b != '' && b != s.batchId) continue;
      final m = (t['marks'] as Map)[s.id];
      if (m != null) {
        out.add({'name': t['name'], 'd': t['date'], 'total': t['total'], 'got': m});
      }
      if (out.length >= 5) break;
    }
    return out;
  }

  String _id() => 'x${DateTime.now().microsecondsSinceEpoch}';

  void setProfile(String k, String v) {
    profile[k] = v;
    _save();
  }

  void addBatch(String name, String subject, String time, int fee) {
    batches.add({'id': _id(), 'name': name, 'subject': subject, 'time': time, 'fee': fee});
    _save();
  }

  void delBatch(String id) {
    batches.removeWhere((b) => b['id'] == id);
    for (var i = 0; i < students.length; i++) {
      final x = students[i];
      if (x.batchId == id) {
        students[i] = Student(x.id, x.name, x.phone, x.fee, x.code);
      }
    }
    _save();
  }

  void addTest(String name, int total, String batch) {
    tests.add({
      'id': _id(),
      'name': name,
      'date': today,
      'total': total,
      'batch': batch,
      'marks': <String, dynamic>{}
    });
    _save();
  }

  void delTest(String id) {
    tests.removeWhere((x) => x['id'] == id);
    _save();
  }

  void setMark(String tid, String sid, num? v) {
    final m = tests.firstWhere((x) => x['id'] == tid)['marks'] as Map;
    if (v == null) {
      m.remove(sid);
    } else {
      m[sid] = v;
    }
    _save();
  }

  void addLedger(String type, String title, int amount) {
    ledger.add({'id': _id(), 'd': today, 'type': type, 'title': title, 'amount': amount});
    _save();
  }

  void delLedger(String id) {
    ledger.removeWhere((x) => x['id'] == id);
    _save();
  }

  void addNotice(String t) {
    notices.insert(0, {'d': today, 't': t});
    if (notices.length > 5) notices.removeLast();
    _save();
  }

  Map<String, dynamic> snapshot(Student s) => {
        'name': s.name,
        'today': today,
        'att': attToday(s.id),
        'present': presentDays(s.id),
        'marked': markedDays(s.id),
        'note': notes[today] ?? '',
        'paid': isPaid(s.id),
        'fee': dueOf(s.id),
        'rem': remaining(s.id),
        'month': month,
        'notices': notices,
        'batch': batchOf(s)?['name'] ?? '',
        'time': batchOf(s)?['time'] ?? '',
        'tests': testsFor(s),
        'hw': hwFor(s),
        'week': weekStats(s.id),
      };

  Future<String> sync() async {
    if (!Cfg.ready) return 'پہلے config.dart میں Supabase کی کیز ڈالیں';
    final c = Supabase.instance.client;
    if (c.auth.currentUser == null) return 'پہلے لاگ اِن کریں';
    try {
      await c.from('backups').upsert({
        'owner': c.auth.currentUser!.id,
        'data': toMap(),
        'updated_at': DateTime.now().toUtc().toIso8601String(),
      }, onConflict: 'owner');
      if (students.isEmpty) return 'بیک اپ ہو گیا';
      await c.from('snapshots').upsert(
          students
              .map((s) => {
                    'code': s.code,
                    'student_id': s.id,
                    'center': center,
                    'data': snapshot(s),
                  })
              .toList(),
          onConflict: 'code');
      return 'سنک مکمل: ${students.length} طلبہ';
    } catch (e) {
      if ('$e'.contains('FREE_LIMIT')) {
        return 'مفت پلان میں ${Cfg.freeLimit} طلبہ تک۔ پرو پلان لیں';
      }
      return 'سنک ناکام: $e';
    }
  }

  Future<void> sendWhatsApp(Student s, [String? text]) async {
    var p = s.phone.replaceAll(RegExp(r'\D'), '');
    if (p.startsWith('0')) p = '92${p.substring(1)}';
    final uri =
        Uri.parse('https://wa.me/$p?text=${Uri.encodeComponent(text ?? message(s))}');
    await launchUrl(uri, mode: LaunchMode.externalApplication);
  }
}

class TuitionApp extends StatelessWidget {
  const TuitionApp({super.key});
  @override
  Widget build(BuildContext context) => MaterialApp(
        title: 'ٹیوشن مینیجر',
        debugShowCheckedModeBanner: false,
        theme: ThemeData(
            colorSchemeSeed: const Color(0xFF0F7B5F), useMaterial3: true),
        darkTheme: ThemeData(
            colorSchemeSeed: const Color(0xFF0F7B5F),
            brightness: Brightness.dark,
            useMaterial3: true),
        builder: (c, child) =>
            Directionality(textDirection: TextDirection.rtl, child: child!),
        home: const Gate(),
      );
}

class Home extends StatefulWidget {
  final VoidCallback onSwitch;
  const Home({super.key, required this.onSwitch});
  @override
  State<Home> createState() => _HomeState();
}

class _HomeState extends State<Home> {
  final store = Store();
  bool ready = false;
  int tab = 0;

  @override
  void initState() {
    super.initState();
    store.load().then((_) {
      setState(() => ready = true);
      if (store.profile['seen'] == null) {
        WidgetsBinding.instance.addPostFrameCallback((_) {
          if (!mounted) return;
          store.setProfile('seen', '1');
          Navigator.push(context,
              MaterialPageRoute(builder: (_) => CenterPage(store)));
        });
      }
    });
  }

  @override
  Widget build(BuildContext context) {
    if (!ready) {
      return const Scaffold(body: Center(child: CircularProgressIndicator()));
    }
    return ListenableBuilder(
      listenable: store,
      builder: (context, _) {
        final pages = [
          StudentsPage(store),
          AttendancePage(store),
          FeesPage(store),
          NotePage(store),
          MorePage(store),
        ];
        return Scaffold(
          appBar: AppBar(
            title: Text(store.center),
            actions: [
              IconButton(
                  tooltip: 'سینٹر سیٹ اپ',
                  icon: const Icon(Icons.settings),
                  onPressed: () => Navigator.push(context,
                      MaterialPageRoute(builder: (_) => CenterPage(store)))),
              IconButton(
                  tooltip: 'ٹیچر/والدین بدلیں',
                  icon: const Icon(Icons.swap_horiz),
                  onPressed: widget.onSwitch),
              Padding(
                padding: const EdgeInsets.symmetric(horizontal: 16),
                child: Center(child: Text('${store.students.length} طلبہ')),
              )
            ],
          ),
          body: SafeArea(child: pages[tab]),
          bottomNavigationBar: NavigationBar(
            selectedIndex: tab,
            onDestinationSelected: (i) => setState(() => tab = i),
            destinations: const [
              NavigationDestination(icon: Icon(Icons.groups), label: 'طلبہ'),
              NavigationDestination(
                  icon: Icon(Icons.how_to_reg), label: 'حاضری'),
              NavigationDestination(icon: Icon(Icons.payments), label: 'فیس'),
              NavigationDestination(icon: Icon(Icons.menu_book), label: 'سبق'),
              NavigationDestination(icon: Icon(Icons.campaign), label: 'پیغامات'),
            ],
          ),
        );
      },
    );
  }
}

Widget empty() => const Padding(
      padding: EdgeInsets.all(24),
      child: Center(child: Text('پہلے "طلبہ" میں بچے شامل کریں۔')),
    );

Widget field(TextEditingController c, String hint, {TextInputType? type}) =>
    Padding(
      padding: const EdgeInsets.only(bottom: 8),
      child: TextField(
        controller: c,
        keyboardType: type,
        decoration: InputDecoration(
            labelText: hint, border: const OutlineInputBorder()),
      ),
    );

// ---------------- طلبہ ----------------
class StudentsPage extends StatefulWidget {
  final Store s;
  const StudentsPage(this.s, {super.key});
  @override
  State<StudentsPage> createState() => _StudentsPageState();
}

class _StudentsPageState extends State<StudentsPage> {
  final n = TextEditingController(),
      p = TextEditingController(),
      f = TextEditingController();
  String? batch;

  @override
  Widget build(BuildContext context) {
    final s = widget.s;
    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        Card(
          child: Padding(
            padding: const EdgeInsets.all(12),
            child: Column(children: [
              field(n, 'بچے کا نام'),
              field(p, 'والدین کا فون (03xx...)', type: TextInputType.phone),
              if (s.batches.isNotEmpty)
                DropdownButton<String?>(
                  isExpanded: true,
                  hint: const Text('بیچ (اختیاری)'),
                  value: batch,
                  items: s.batches
                      .map((b) => DropdownMenuItem<String?>(
                          value: b['id'] as String, child: Text('${b['name']}')))
                      .toList(),
                  onChanged: (v) => setState(() => batch = v),
                ),
              field(f, 'ماہانہ فیس (خالی چھوڑیں تو بیچ کی فیس)', type: TextInputType.number),
              SizedBox(
                width: double.infinity,
                child: FilledButton.icon(
                  icon: const Icon(Icons.add),
                  label: const Text('شامل کریں'),
                  onPressed: () {
                    if (n.text.trim().isEmpty) return;
                    final bl = s.batches.where((x) => x['id'] == batch).toList();
                    final fee = int.tryParse(f.text) ??
                        (bl.isNotEmpty ? (bl.first['fee'] as num).toInt() : 0);
                    s.addStudent(n.text.trim(), p.text.trim(), fee, batch);
                    n.clear();
                    p.clear();
                    f.clear();
                  },
                ),
              ),
            ]),
          ),
        ),
        ...s.students.map((st) => Card(
              child: ListTile(
                leading: const Icon(Icons.description_outlined),
                onTap: () => Navigator.push(context,
                    MaterialPageRoute(builder: (_) => DocPage(s, st))),
                title: Text(st.name),
                subtitle: Text(
                    '${st.phone.isEmpty ? "-" : st.phone} · ${st.fee} روپے${s.batchOf(st) == null ? "" : " · ${s.batchOf(st)!['name']}"}'),
                trailing: IconButton(
                  icon: const Icon(Icons.delete_outline),
                  onPressed: () async {
                    final ok = await showDialog<bool>(
                      context: context,
                      builder: (c) => AlertDialog(
                        title: Text('${st.name} حذف کریں؟'),
                        actions: [
                          TextButton(
                              onPressed: () => Navigator.pop(c, false),
                              child: const Text('نہیں')),
                          TextButton(
                              onPressed: () => Navigator.pop(c, true),
                              child: const Text('حذف')),
                        ],
                      ),
                    );
                    if (ok == true) s.delStudent(st.id);
                  },
                ),
              ),
            )),
      ],
    );
  }
}

// ---------------- حاضری ----------------
class AttendancePage extends StatelessWidget {
  final Store s;
  const AttendancePage(this.s, {super.key});
  @override
  Widget build(BuildContext context) {
    if (s.students.isEmpty) return empty();
    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        Text('آج: ${s.today}'),
        const SizedBox(height: 8),
        ...s.students.map((st) {
          final a = s.attToday(st.id);
          return Card(
            child: Padding(
              padding: const EdgeInsets.all(12),
              child: Row(children: [
                Expanded(
                    child: Text(st.name,
                        style: const TextStyle(fontWeight: FontWeight.bold))),
                a == true
                    ? FilledButton(
                        onPressed: () => s.setAtt(st.id, true),
                        child: const Text('حاضر'))
                    : FilledButton.tonal(
                        onPressed: () => s.setAtt(st.id, true),
                        child: const Text('حاضر')),
                const SizedBox(width: 8),
                a == false
                    ? FilledButton(
                        style: FilledButton.styleFrom(
                            backgroundColor: Colors.red.shade700),
                        onPressed: () => s.setAtt(st.id, false),
                        child: const Text('غیر حاضر'))
                    : FilledButton.tonal(
                        onPressed: () => s.setAtt(st.id, false),
                        child: const Text('غیر حاضر')),
              ]),
            ),
          );
        }),
      ],
    );
  }
}

// ---------------- فیس ----------------
class FeesPage extends StatelessWidget {
  final Store s;
  const FeesPage(this.s, {super.key});

  Future<void> ask(BuildContext context, Student st) async {
    final c = TextEditingController();
    final ok = await showDialog<bool>(
      context: context,
      builder: (d) => AlertDialog(
        title: Text('${st.name}: قسط (باقی ${s.remaining(st.id)})'),
        content: TextField(
            controller: c, keyboardType: TextInputType.number, autofocus: true),
        actions: [
          TextButton(
              onPressed: () => Navigator.pop(d, false),
              child: const Text('منسوخ')),
          TextButton(
              onPressed: () => Navigator.pop(d, true),
              child: const Text('درج کریں')),
        ],
      ),
    );
    final a = int.tryParse(c.text);
    if (ok == true && a != null && a > 0) s.addPayment(st.id, a);
  }

  @override
  Widget build(BuildContext context) {
    if (s.students.isEmpty) return empty();
    var total = 0;
    for (final st in s.students) {
      total += s.dueOf(st.id);
    }
    final got = s.receivedTotal();
    final pending = s.students.where((x) => s.remaining(x.id) > 0).length;
    Widget box(String t, int v, Color c) => Expanded(
          child: Card(
            child: Padding(
              padding: const EdgeInsets.all(14),
              child: Column(children: [
                Text(t),
                Text('$v',
                    style: TextStyle(
                        fontSize: 26, fontWeight: FontWeight.bold, color: c)),
              ]),
            ),
          ),
        );
    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        Row(children: [
          box('وصول', got, Colors.green.shade700),
          box('باقی', total - got, Colors.red.shade700),
        ]),
        if (pending > 0)
          Card(
            child: ListTile(
              title: Text('$pending بچوں کی فیس باقی ہے'),
              trailing: FilledButton.tonal(
                onPressed: () => Navigator.push(context,
                    MaterialPageRoute(builder: (_) => FeeRemindPage(s))),
                child: const Text('یاد دہانی'),
              ),
            ),
          ),
        Text('مہینہ: ${s.month}'),
        const SizedBox(height: 8),
        ...s.students.map((st) {
          final p = s.isPaid(st.id);
          final due = s.dueOf(st.id);
          final rem = s.remaining(st.id);
          return Card(
            child: Padding(
              padding: const EdgeInsets.all(12),
              child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                Row(children: [
                  Expanded(
                      child: Text(st.name,
                          style: const TextStyle(fontWeight: FontWeight.bold))),
                  Chip(label: Text(p ? 'ادا' : 'باقی $rem')),
                ]),
                Text(
                    'واجب $due${due != st.fee ? " (رعایت کے بعد)" : ""} · وصول ${due - rem}',
                    style: const TextStyle(fontSize: 12)),
                Row(children: [
                  TextButton(
                      onPressed: () => s.togglePaid(st.id),
                      child: Text(p ? 'واپس' : 'پوری ادا')),
                  if (!p)
                    TextButton(
                        onPressed: () => ask(context, st),
                        child: const Text('قسط')),
                  TextButton(
                      onPressed: () => Navigator.push(
                          context,
                          MaterialPageRoute(
                              builder: (_) => DocPage(s, st, receipt: true))),
                      child: const Text('رسید')),
                ]),
              ]),
            ),
          );
        }),
      ],
    );
  }
}

class FeeRemindPage extends StatefulWidget {
  final Store s;
  const FeeRemindPage(this.s, {super.key});
  @override
  State<FeeRemindPage> createState() => _FeeRemindPageState();
}

class _FeeRemindPageState extends State<FeeRemindPage> {
  late final List<Student> q = widget.s.students
      .where((x) => widget.s.remaining(x.id) > 0 && x.phone.trim().isNotEmpty)
      .toList();
  int i = 0;

  @override
  Widget build(BuildContext context) {
    final s = widget.s;
    return subPage('فیس کی یاد دہانی', [
      if (q.isEmpty)
        const Card(child: ListTile(title: Text('کوئی باقی فیس نہیں ✅')))
      else if (i >= q.length)
        const Card(child: ListTile(title: Text('سب کو بھیج دیا گیا ✅')))
      else
        Card(
          color: Theme.of(context).colorScheme.primaryContainer,
          child: Padding(
            padding: const EdgeInsets.all(12),
            child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              Text('اگلا: ${q[i].name}',
                  style: const TextStyle(fontWeight: FontWeight.bold)),
              Text('${i + 1} / ${q.length} · باقی ${s.remaining(q[i].id)} روپے'),
              const SizedBox(height: 8),
              Row(children: [
                FilledButton(
                  onPressed: () async {
                    final st = q[i];
                    await s.sendWhatsApp(st, s.feeReminder(st));
                    setState(() => i++);
                  },
                  child: const Text('واٹس ایپ کھولیں'),
                ),
                const SizedBox(width: 8),
                TextButton(
                    onPressed: () => setState(() => i++),
                    child: const Text('چھوڑیں')),
              ]),
            ]),
          ),
        ),
    ]);
  }
}

// ---------------- سبق ----------------
class NotePage extends StatefulWidget {
  final Store s;
  const NotePage(this.s, {super.key});
  @override
  State<NotePage> createState() => _NotePageState();
}

class _NotePageState extends State<NotePage> {
  late final center = TextEditingController(text: widget.s.center);
  late final note = TextEditingController(text: widget.s.notes[widget.s.today]);
  bool up = false;
  String hwBatch = '';

  void snack(String m) {
    if (mounted) ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(m)));
  }

  Future<void> pick(ImageSource src) async {
    if (!Cfg.ready || Supabase.instance.client.auth.currentUser == null) {
      snack('پہلے "پیغامات" ٹیب میں لاگ اِن کریں');
      return;
    }
    final x = await ImagePicker().pickImage(source: src, maxWidth: 1280, imageQuality: 70);
    if (x == null) return;
    setState(() => up = true);
    try {
      final c = Supabase.instance.client;
      final path = '${c.auth.currentUser!.id}/${DateTime.now().millisecondsSinceEpoch}.jpg';
      await c.storage.from('homework').upload(path, File(x.path),
          fileOptions: const FileOptions(contentType: 'image/jpeg'));
      widget.s.addHomework(c.storage.from('homework').getPublicUrl(path), path, hwBatch);
      snack('ہوم ورک لگ گیا');
    } catch (e) {
      snack('اپ لوڈ ناکام: $e');
    }
    if (mounted) setState(() => up = false);
  }

  @override
  Widget build(BuildContext context) {
    final s = widget.s;
    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        Card(
          child: Padding(
            padding: const EdgeInsets.all(12),
            child: Column(children: [
              TextField(
                controller: center,
                onChanged: s.setCenter,
                decoration: const InputDecoration(
                    labelText: 'سینٹر کا نام', border: OutlineInputBorder()),
              ),
              const SizedBox(height: 8),
              TextField(
                controller: note,
                maxLines: 3,
                decoration: const InputDecoration(
                    labelText: 'آج کیا پڑھایا / ہوم ورک',
                    border: OutlineInputBorder()),
              ),
              const SizedBox(height: 8),
              SizedBox(
                width: double.infinity,
                child: FilledButton(
                    onPressed: () {
                      s.setNote(note.text);
                      ScaffoldMessenger.of(context).showSnackBar(
                          const SnackBar(content: Text('محفوظ ہو گیا')));
                    },
                    child: const Text('محفوظ کریں')),
              ),
            ]),
          ),
        ),
        Card(
          child: Padding(
            padding: const EdgeInsets.all(12),
            child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              const Text('ہوم ورک کی تصویر',
                  style: TextStyle(fontWeight: FontWeight.bold)),
              if (s.batches.isNotEmpty)
                DropdownButton<String>(
                  isExpanded: true,
                  value: hwBatch,
                  items: [
                    const DropdownMenuItem(value: '', child: Text('سب طلبہ')),
                    ...s.batches.map((b) => DropdownMenuItem(
                        value: b['id'] as String, child: Text('${b['name']}'))),
                  ],
                  onChanged: (v) => setState(() => hwBatch = v ?? ''),
                ),
              Row(children: [
                Expanded(
                    child: FilledButton.icon(
                        icon: const Icon(Icons.photo_camera),
                        label: const Text('کیمرہ'),
                        onPressed: up ? null : () => pick(ImageSource.camera))),
                const SizedBox(width: 8),
                Expanded(
                    child: FilledButton.tonalIcon(
                        icon: const Icon(Icons.photo),
                        label: const Text('گیلری'),
                        onPressed: up ? null : () => pick(ImageSource.gallery))),
              ]),
              if (up) const LinearProgressIndicator(),
              ...s.homework.reversed.take(3).map((h) => ListTile(
                    dense: true,
                    contentPadding: EdgeInsets.zero,
                    leading: ClipRRect(
                        borderRadius: BorderRadius.circular(6),
                        child: Image.network('${h['url']}',
                            width: 48, height: 48, fit: BoxFit.cover)),
                    title: Text('${h['d']}'),
                    trailing: IconButton(
                        icon: const Icon(Icons.delete_outline),
                        onPressed: () => s.delHomework('${h['id']}')),
                  )),
            ]),
          ),
        ),
        const Padding(
          padding: EdgeInsets.symmetric(vertical: 8),
          child: Text('والدین کو واٹس ایپ پر بھیجیں:'),
        ),
        ...s.students.map((st) => Card(
              child: ListTile(
                title: Text(st.name),
                trailing: FilledButton.icon(
                  icon: const Icon(Icons.send),
                  label: const Text('واٹس ایپ'),
                  onPressed: () => s.sendWhatsApp(st),
                ),
              ),
            )),
        if (s.students.isEmpty) empty(),
      ],
    );
  }
}

// ---------------- شروع: ٹیچر یا والدین ----------------
class Gate extends StatefulWidget {
  const Gate({super.key});
  @override
  State<Gate> createState() => _GateState();
}

class _GateState extends State<Gate> {
  String? role;
  bool loaded = false;

  @override
  void initState() {
    super.initState();
    SharedPreferences.getInstance().then((p) {
      setState(() {
        role = p.getString('role');
        loaded = true;
      });
    });
  }

  Future<void> pick(String? r) async {
    final p = await SharedPreferences.getInstance();
    if (r == null) {
      await p.remove('role');
    } else {
      await p.setString('role', r);
    }
    setState(() => role = r);
  }

  @override
  Widget build(BuildContext context) {
    if (!loaded) {
      return const Scaffold(body: Center(child: CircularProgressIndicator()));
    }
    if (role == 'teacher') return Home(onSwitch: () => pick(null));
    if (role == 'parent') return ParentHome(onSwitch: () => pick(null));
    return Scaffold(
      body: SafeArea(
        child: Padding(
          padding: const EdgeInsets.all(24),
          child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
            const Icon(Icons.school, size: 72),
            const SizedBox(height: 12),
            const Text('ٹیوشن مینیجر',
                style: TextStyle(fontSize: 26, fontWeight: FontWeight.bold)),
            const SizedBox(height: 32),
            SizedBox(
                width: double.infinity,
                child: FilledButton(
                    onPressed: () => pick('teacher'),
                    child: const Text('میں ٹیچر ہوں'))),
            const SizedBox(height: 12),
            SizedBox(
                width: double.infinity,
                child: FilledButton.tonal(
                    onPressed: () => pick('parent'),
                    child: const Text('میں والد/والدہ ہوں'))),
          ]),
        ),
      ),
    );
  }
}

// ---------------- پیغامات اور سنک (ٹیچر) ----------------
class MorePage extends StatefulWidget {
  final Store s;
  const MorePage(this.s, {super.key});
  @override
  State<MorePage> createState() => _MorePageState();
}

class _MorePageState extends State<MorePage> {
  final email = TextEditingController(), pass = TextEditingController();
  final msg = TextEditingController(text: 'السلام علیکم! {name} کے والدین، ');
  String filter = 'all', status = '';
  List<Student> queue = [];
  int qi = 0;
  String plan = '';
  bool weekly = false;
  int qCount = 0;

  @override
  void initState() {
    super.initState();
    loadPlan();
  }

  bool get proActive {
    final d = DateTime.tryParse(plan);
    return d != null && !d.isBefore(DateTime.now().subtract(const Duration(days: 1)));
  }

  Future<void> loadPlan() async {
    if (!loggedIn) return;
    try {
      final r = await Supabase.instance.client
          .from('plans')
          .select('paid_until')
          .maybeSingle();
      if (mounted) setState(() => plan = r == null ? '' : '${r['paid_until']}');
      final q = await Supabase.instance.client
          .from('questions')
          .select('a')
          .order('created_at', ascending: false)
          .limit(50);
      if (mounted) {
        setState(() => qCount = (q as List).where((x) => x['a'] == null).length);
      }
    } catch (_) {}
  }

  bool get loggedIn =>
      Cfg.ready && Supabase.instance.client.auth.currentUser != null;

  List<Student> targets() => widget.s.students.where((x) {
        if (x.phone.trim().isEmpty) return false;
        if (filter == 'unpaid') return !widget.s.isPaid(x.id);
        if (filter == 'absent') return widget.s.attToday(x.id) == false;
        return true;
      }).toList();

  Future<void> auth(bool signup) async {
    if (!Cfg.ready) {
      setState(() => status = 'پہلے config.dart میں Supabase کی کیز ڈالیں');
      return;
    }
    final a = Supabase.instance.client.auth;
    try {
      if (signup) {
        await a.signUp(email: email.text.trim(), password: pass.text);
      } else {
        await a.signInWithPassword(
            email: email.text.trim(), password: pass.text);
      }
      setState(() => status = 'لاگ اِن ہو گیا');
      loadPlan();
    } catch (e) {
      setState(() => status = 'خرابی: $e');
    }
  }

  @override
  Widget build(BuildContext context) {
    final s = widget.s;
    final t = targets();
    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        Card(
          child: Padding(
            padding: const EdgeInsets.all(12),
            child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              const Text('والدین کے لیے لائیو ریکارڈ (سنک)',
                  style: TextStyle(fontWeight: FontWeight.bold)),
              const SizedBox(height: 8),
              if (!loggedIn) ...[
                field(email, 'ای میل', type: TextInputType.emailAddress),
                TextField(
                    controller: pass,
                    obscureText: true,
                    decoration: const InputDecoration(
                        labelText: 'پاس ورڈ', border: OutlineInputBorder())),
                const SizedBox(height: 8),
                Row(children: [
                  Expanded(
                      child: FilledButton(
                          onPressed: () => auth(false),
                          child: const Text('لاگ اِن'))),
                  const SizedBox(width: 8),
                  Expanded(
                      child: FilledButton.tonal(
                          onPressed: () => auth(true),
                          child: const Text('نیا اکاؤنٹ'))),
                ]),
              ] else
                SizedBox(
                  width: double.infinity,
                  child: FilledButton.icon(
                    icon: const Icon(Icons.cloud_upload),
                    label: const Text('ابھی سنک کریں'),
                    onPressed: () async {
                      final r = await s.sync();
                      setState(() => status = r);
                    },
                  ),
                ),
              if (loggedIn)
                TextButton(
                  onPressed: () async {
                    final ok = await showDialog<bool>(
                      context: context,
                      builder: (c) => AlertDialog(
                        title: const Text('موجودہ ڈیٹا کلاؤڈ بیک اپ سے بدل دیں؟'),
                        actions: [
                          TextButton(
                              onPressed: () => Navigator.pop(c, false),
                              child: const Text('نہیں')),
                          TextButton(
                              onPressed: () => Navigator.pop(c, true),
                              child: const Text('ہاں')),
                        ],
                      ),
                    );
                    if (ok == true) {
                      final r = await s.restore();
                      setState(() => status = r);
                    }
                  },
                  child: const Text('کلاؤڈ بیک اپ سے بحال کریں'),
                ),
              if (status.isNotEmpty)
                Padding(
                    padding: const EdgeInsets.only(top: 8), child: Text(status)),
              if (s.syncStatus.isNotEmpty)
                Text('خودکار: ${s.syncStatus}', style: const TextStyle(fontSize: 12)),
              const SizedBox(height: 4),
              const Text(
                  'ہر بچے کا کوڈ واٹس ایپ میسج میں جاتا ہے۔ والدین ایپ میں "والد/والدہ" چن کر کوڈ ڈالتے ہیں۔',
                  style: TextStyle(fontSize: 12)),
            ]),
          ),
        ),
        if (loggedIn)
          Card(
            child: Padding(
              padding: const EdgeInsets.all(12),
              child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                Text(
                    proActive
                        ? 'پرو پلان فعال: $plan تک'
                        : 'مفت پلان: ${Cfg.freeLimit} طلبہ تک لائیو سنک',
                    style: const TextStyle(fontWeight: FontWeight.bold)),
                if (!proActive) ...[
                  const SizedBox(height: 6),
                  Text('پرو: ${Cfg.proPrice} روپے ماہانہ، لامحدود طلبہ۔\n${Cfg.payInfo}'),
                  const SizedBox(height: 8),
                  FilledButton.tonal(
                    onPressed: () {
                      final m = 'پرو پلان کی ادائیگی کر دی ہے۔ اکاؤنٹ: '
                          '${Supabase.instance.client.auth.currentUser?.email}';
                      launchUrl(
                          Uri.parse('https://wa.me/${Cfg.adminWhatsapp}?text=${Uri.encodeComponent(m)}'),
                          mode: LaunchMode.externalApplication);
                    },
                    child: const Text('ادائیگی کی رسید واٹس ایپ پر بھیجیں'),
                  ),
                ],
                TextButton(onPressed: loadPlan, child: const Text('پلان تازہ کریں')),
              ]),
            ),
          ),
        Card(
          child: Padding(
            padding: const EdgeInsets.all(12),
            child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              const Text('بلک پیغام',
                  style: TextStyle(fontWeight: FontWeight.bold)),
              const SizedBox(height: 8),
              DropdownButton<String>(
                isExpanded: true,
                value: filter,
                items: const [
                  DropdownMenuItem(value: 'all', child: Text('سب والدین')),
                  DropdownMenuItem(
                      value: 'unpaid', child: Text('جن کی فیس باقی ہے')),
                  DropdownMenuItem(
                      value: 'absent', child: Text('جو آج غیر حاضر ہیں')),
                ],
                onChanged: (v) => setState(() {
                  filter = v!;
                  queue = [];
                }),
              ),
              TextField(
                controller: msg,
                maxLines: 4,
                decoration: const InputDecoration(
                    helperText: '{name} کی جگہ بچے کا نام آئے گا',
                    border: OutlineInputBorder()),
              ),
              const SizedBox(height: 8),
              Text('${t.length} والدین چنے گئے'),
              const SizedBox(height: 8),
              Row(children: [
                Expanded(
                    child: FilledButton(
                        onPressed: t.isEmpty
                            ? null
                            : () => setState(() {
                                  queue = t;
                                  qi = 0;
                                  weekly = false;
                                }),
                        child: const Text('واٹس ایپ قطار'))),
                const SizedBox(width: 8),
                Expanded(
                    child: FilledButton.tonal(
                        onPressed: () {
                          final x = msg.text.replaceAll('{name}', 'طلبہ').trim();
                          if (x.isEmpty) return;
                          s.addNotice(x);
                          setState(() => status = 'نوٹس بورڈ پر لگ گیا، سنک کریں');
                        },
                        child: const Text('نوٹس بورڈ'))),
              ]),
            ]),
          ),
        ),
        Card(
          child: Column(children: [
            if (loggedIn)
              ListTile(
                leading: const Icon(Icons.question_answer),
                title: Text('والدین کے سوالات${qCount > 0 ? " ($qCount بغیر جواب)" : ""}'),
                trailing: const Icon(Icons.chevron_left),
                onTap: () async {
                  await Navigator.push(context,
                      MaterialPageRoute(builder: (_) => QuestionsPage(s)));
                  loadPlan();
                },
              ),
            ListTile(
              leading: const Icon(Icons.summarize),
              title: const Text('ہفتہ وار خلاصہ (واٹس ایپ)'),
              subtitle: const Text('حاضری، ٹیسٹ اور فیس، ہر والد کو ایک ٹیپ میں'),
              onTap: () => setState(() {
                queue = s.students.where((x) => x.phone.trim().isNotEmpty).toList();
                qi = 0;
                weekly = true;
              }),
            ),
          ]),
        ),
        Card(
          child: Padding(
            padding: const EdgeInsets.all(12),
            child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              const Text('فوری اطلاع (والدین کو نوٹیفکیشن جاتا ہے)',
                  style: TextStyle(fontWeight: FontWeight.bold)),
              const SizedBox(height: 8),
              Wrap(spacing: 8, children: [
                for (final x in const [
                  'آج کلاس نہیں ہوگی',
                  'کل کلاس نہیں ہوگی',
                  'آج کلاس دیر سے شروع ہوگی',
                  'کل ٹیسٹ ہوگا',
                ])
                  ActionChip(
                    label: Text(x),
                    onPressed: () {
                      s.addNotice(x);
                      setState(() => status = 'نوٹس لگ گیا: $x');
                    },
                  ),
              ]),
            ]),
          ),
        ),
        if (queue.isNotEmpty && qi < queue.length)
          Card(
            color: Theme.of(context).colorScheme.primaryContainer,
            child: ListTile(
              title: Text('اگلا: ${queue[qi].name}'),
              subtitle: Text('${qi + 1} / ${queue.length}'),
              trailing: FilledButton(
                onPressed: () async {
                  final st = queue[qi];
                  await s.sendWhatsApp(
                      st,
                      weekly
                          ? s.weeklyMessage(st)
                          : msg.text.replaceAll('{name}', st.name));
                  setState(() => qi++);
                },
                child: const Text('کھولیں'),
              ),
            ),
          ),
        if (queue.isNotEmpty && qi >= queue.length)
          const Card(child: ListTile(title: Text('سب کو بھیج دیا گیا ✅'))),
        if (s.notices.isNotEmpty) ...[
          const Padding(
              padding: EdgeInsets.symmetric(vertical: 8),
              child: Text('نوٹس بورڈ (والدین کو نظر آتا ہے)')),
          ...s.notices.map((n) => Card(
              child: ListTile(title: Text(n['t'] ?? ''), subtitle: Text(n['d'] ?? '')))),
        ],
      ],
    );
  }
}

// ---------------- والدین کی ایپ ----------------
class ParentHome extends StatefulWidget {
  final VoidCallback onSwitch;
  const ParentHome({super.key, required this.onSwitch});
  @override
  State<ParentHome> createState() => _ParentHomeState();
}

class _ParentHomeState extends State<ParentHome> {
  final codeCtl = TextEditingController();
  List<String> codes = [];
  Map<String, Map<String, dynamic>> snaps = {};
  StreamSubscription? _sub;
  bool _reg = false;
  List qa = [];
  final qCtl = TextEditingController();
  String? code;
  Map<String, dynamic>? snap;
  String err = '';
  bool loading = false;

  @override
  void initState() {
    super.initState();
    if (pushReady) {
      _sub = FirebaseMessaging.onMessage.listen((m) {
        if (code != null) fetch(code!);
        final b = m.notification?.body;
        if (b != null && mounted) {
          ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(b)));
        }
      });
    }
    SharedPreferences.getInstance().then((p) {
      code = p.getString('parent_code');
      final cached = p.getString('parent_snap');
      if (cached != null) snap = Map<String, dynamic>.from(jsonDecode(cached));
      codes = p.getStringList('parent_codes') ?? (code != null ? [code!] : []);
      final sj = p.getString('parent_snaps');
      if (sj != null) {
        (jsonDecode(sj) as Map).forEach((k, v) {
          snaps[k] = Map<String, dynamic>.from(v);
        });
      }
      if (snap == null && code != null) snap = snaps[code];
      if (code != null) fetch(code!);
      setState(() {});
    });
  }

  @override
  void dispose() {
    _sub?.cancel();
    super.dispose();
  }

  Future<void> registerPush(String c) async {
    if (!pushReady) return;
    try {
      final m = FirebaseMessaging.instance;
      await m.requestPermission();
      final tok = await m.getToken();
      if (tok != null) {
        await Supabase.instance.client
            .rpc('register_token', params: {'p_code': c, 'p_token': tok});
      }
      if (!_reg) {
        _reg = true;
        m.onTokenRefresh.listen((t) {
          if (code != null) {
            Supabase.instance.client
                .rpc('register_token', params: {'p_code': code, 'p_token': t})
                .then((_) {}, onError: (_) {});
          }
        });
      }
    } catch (_) {}
  }

  Future<void> unregisterPush(String c) async {
    if (!pushReady) return;
    try {
      final tok = await FirebaseMessaging.instance.getToken();
      if (tok != null) {
        await Supabase.instance.client
            .rpc('unregister_token', params: {'p_token': tok, 'p_code': c});
      }
    } catch (_) {}
  }

  Future<void> loadQa(String c) async {
    try {
      final r = await Supabase.instance.client
          .rpc('get_questions', params: {'p_code': c});
      if (mounted && code == c) setState(() => qa = List.from(r ?? []));
    } catch (_) {}
  }

  Future<void> ask() async {
    final c = code, q = qCtl.text.trim();
    if (c == null || q.isEmpty) return;
    try {
      await Supabase.instance.client
          .rpc('ask_question', params: {'p_code': c, 'p_q': q});
      qCtl.clear();
      await loadQa(c);
    } catch (_) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
            const SnackBar(content: Text('سوال نہیں بھیجا جا سکا، پہلے والے کے جواب کا انتظار کریں')));
      }
    }
  }

  Future<void> persist() async {
    final p = await SharedPreferences.getInstance();
    await p.setStringList('parent_codes', codes);
    await p.setString('parent_snaps', jsonEncode(snaps));
    if (code != null) {
      await p.setString('parent_code', code!);
      await p.setString('parent_snap', jsonEncode(snaps[code]));
    } else {
      await p.remove('parent_code');
      await p.remove('parent_snap');
    }
  }

  Future<void> fetch(String raw) async {
    final c = raw.trim().toLowerCase();
    if (!Cfg.ready) {
      setState(() => err = 'ایپ ابھی سیٹ اپ نہیں ہوئی (config.dart)');
      return;
    }
    setState(() {
      loading = true;
      err = '';
    });
    try {
      final r = await Supabase.instance.client
          .rpc('get_snapshot', params: {'p_code': c});
      if (r == null) {
        err = 'کوڈ غلط ہے';
        codes.remove(c);
        snaps.remove(c);
        if (code == c) {
          code = codes.isNotEmpty ? codes.first : null;
          snap = code == null ? null : snaps[code];
        }
      } else {
        final m = Map<String, dynamic>.from(r);
        snaps[c] = m;
        if (!codes.contains(c)) codes.add(c);
        code = c;
        snap = m;
        registerPush(c);
        loadQa(c);
      }
      await persist();
    } catch (e) {
      err = 'انٹرنیٹ یا سرور کا مسئلہ: $e';
    }
    if (mounted) setState(() => loading = false);
  }

  void select(String c) {
    setState(() {
      code = c;
      snap = snaps[c];
    });
    persist();
    fetch(c);
  }

  Future<void> addChild() async {
    final c = TextEditingController();
    final ok = await showDialog<bool>(
      context: context,
      builder: (d) => AlertDialog(
        title: const Text('دوسرے بچے کا کوڈ'),
        content: TextField(controller: c, autofocus: true),
        actions: [
          TextButton(
              onPressed: () => Navigator.pop(d, false),
              child: const Text('منسوخ')),
          TextButton(
              onPressed: () => Navigator.pop(d, true),
              child: const Text('شامل کریں')),
        ],
      ),
    );
    if (ok == true && c.text.trim().isNotEmpty) await fetch(c.text);
  }

  Future<void> clear() async {
    final c = code;
    if (c == null) return;
    await unregisterPush(c);
    codes.remove(c);
    snaps.remove(c);
    code = codes.isNotEmpty ? codes.first : null;
    snap = code == null ? null : snaps[code];
    await persist();
    if (mounted) setState(() => codeCtl.clear());
  }

  @override
  Widget build(BuildContext context) {
    final d = snap == null ? null : Map<String, dynamic>.from(snap!['data']);
    return Scaffold(
      appBar: AppBar(
        title: Text(snap?['center'] ?? 'والدین'),
        actions: [
          if (code != null)
            IconButton(tooltip: 'دوسرا بچہ', icon: const Icon(Icons.person_add), onPressed: addChild),
          if (code != null)
            IconButton(tooltip: 'یہ بچہ ہٹائیں', icon: const Icon(Icons.logout), onPressed: clear),
          IconButton(icon: const Icon(Icons.swap_horiz), onPressed: widget.onSwitch),
        ],
      ),
      body: SafeArea(
        child: d == null
            ? ListView(padding: const EdgeInsets.all(16), children: [
                const Text('ٹیچر کے بھیجے ہوئے میسج سے 8 حرفی کوڈ یہاں ڈالیں'),
                const SizedBox(height: 12),
                field(codeCtl, 'کوڈ'),
                FilledButton(
                    onPressed: loading ? null : () => fetch(codeCtl.text),
                    child: Text(loading ? '...' : 'ریکارڈ دیکھیں')),
                if (err.isNotEmpty)
                  Padding(padding: const EdgeInsets.only(top: 12), child: Text(err)),
              ])
            : RefreshIndicator(
                onRefresh: () => fetch(code!),
                child: ListView(
                  physics: const AlwaysScrollableScrollPhysics(),
                  padding: const EdgeInsets.all(16),
                  children: [
                    if (codes.length > 1)
                      Wrap(
                        spacing: 8,
                        children: codes
                            .map((c) => ChoiceChip(
                                  label: Text('${snaps[c]?['data']?['name'] ?? c}'),
                                  selected: c == code,
                                  onSelected: (_) => select(c),
                                ))
                            .toList(),
                      ),
                    if (err.isNotEmpty)
                      Card(
                          child: ListTile(
                              leading: const Icon(Icons.cloud_off),
                              title: Text(err.contains('کوڈ')
                                  ? err
                                  : 'آف لائن: آخری محفوظ ریکارڈ'))),
                    if ((d['batch'] ?? '').toString().isNotEmpty)
                      Card(
                          child: ListTile(
                              leading: const Icon(Icons.schedule),
                              title: Text('${d['batch']}'),
                              subtitle: Text('${d['time'] ?? ''}'))),
                    Card(child: ListTile(title: Text('${d['name']}'), subtitle: Text('تازہ ترین: ${d['today']}'))),
                    Row(children: [
                      Expanded(
                          child: Card(
                              child: ListTile(
                                  title: const Text('آج'),
                                  subtitle: Text(
                                      d['att'] == true ? 'حاضر' : d['att'] == false ? 'غیر حاضر' : '-',
                                      style: const TextStyle(fontSize: 22, fontWeight: FontWeight.bold))))),
                      Expanded(
                          child: Card(
                              child: ListTile(
                                  title: const Text('اس ماہ'),
                                  subtitle: Text('${d['present']}/${d['marked']}',
                                      style: const TextStyle(fontSize: 22, fontWeight: FontWeight.bold))))),
                    ]),
                    Card(
                        child: ListTile(
                            title: const Text('آج کا سبق'),
                            subtitle: Text((d['note'] ?? '').toString().isEmpty
                                ? 'ابھی نہیں لکھا گیا'
                                : d['note']))),
                    Card(
                        child: ListTile(
                            title: Text('فیس ${d['month']}'),
                            subtitle: Text('${d['fee']} روپے'),
                            trailing: Chip(label: Text(d['paid'] == true ? 'ادا' : 'باقی ${d['rem'] ?? d['fee']}')))),
                    if ((d['notices'] as List).isNotEmpty) ...[
                      const Padding(
                          padding: EdgeInsets.symmetric(vertical: 8),
                          child: Text('نوٹس بورڈ')),
                      ...(d['notices'] as List).map((n) => Card(
                          child: ListTile(title: Text('${n['t']}'), subtitle: Text('${n['d']}')))),
                    ],
                    if (d['week'] != null && (d['week'] as List)[0] > 0)
                      Card(
                          child: ListTile(
                              leading: const Icon(Icons.insights),
                              title: const Text('اس ہفتے'),
                              subtitle: Text(
                                  '${(d['week'] as List)[0]} میں سے ${(d['week'] as List)[1]} دن حاضر'))),
                    if ((d['hw'] ?? []).isNotEmpty) ...[
                      const Padding(
                          padding: EdgeInsets.symmetric(vertical: 8),
                          child: Text('ہوم ورک')),
                      SizedBox(
                        height: 110,
                        child: ListView(
                          scrollDirection: Axis.horizontal,
                          children: (d['hw'] as List)
                              .map((h) => Padding(
                                    padding: const EdgeInsets.only(left: 8),
                                    child: GestureDetector(
                                      onTap: () => showDialog(
                                          context: context,
                                          builder: (_) => Dialog(
                                              child: InteractiveViewer(
                                                  child: Image.network('${h['url']}')))),
                                      child: ClipRRect(
                                          borderRadius: BorderRadius.circular(8),
                                          child: Image.network('${h['url']}',
                                              height: 110, width: 110, fit: BoxFit.cover)),
                                    ),
                                  ))
                              .toList(),
                        ),
                      ),
                    ],
                    if ((d['tests'] ?? []).isNotEmpty) ...[
                      const Padding(
                          padding: EdgeInsets.symmetric(vertical: 8),
                          child: Text('ٹیسٹ کے نتائج')),
                      ...(d['tests'] as List).map((x) => Card(
                          child: ListTile(
                              title: Text('${x['name']}'),
                              subtitle: Text('${x['d']}'),
                              trailing: Text('${x['got']}/${x['total']}',
                                  style: const TextStyle(
                                      fontSize: 18, fontWeight: FontWeight.bold))))),
                    ],
                    Card(
                      child: Padding(
                        padding: const EdgeInsets.all(12),
                        child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                          const Text('ٹیچر سے سوال',
                              style: TextStyle(fontWeight: FontWeight.bold)),
                          const SizedBox(height: 8),
                          TextField(
                              controller: qCtl,
                              maxLines: 2,
                              decoration: const InputDecoration(
                                  hintText: 'اپنا سوال لکھیں',
                                  border: OutlineInputBorder())),
                          const SizedBox(height: 8),
                          FilledButton(onPressed: ask, child: const Text('بھیجیں')),
                          ...qa.map((x) => ListTile(
                                dense: true,
                                contentPadding: EdgeInsets.zero,
                                title: Text('${x['q']}'),
                                subtitle: Text(x['a'] == null
                                    ? 'جواب کا انتظار...'
                                    : 'جواب: ${x['a']}'),
                              )),
                        ]),
                      ),
                    ),
                    const Center(child: Text('نیچے کھینچ کر تازہ کریں', style: TextStyle(fontSize: 12))),
                  ],
                ),
              ),
      ),
    );
  }
}

// ---------------- سینٹر سیٹ اپ ----------------
Widget subPage(String title, List<Widget> children) => Scaffold(
      appBar: AppBar(title: Text(title)),
      body: SafeArea(
          child: ListView(padding: const EdgeInsets.all(16), children: children)),
    );

class CenterPage extends StatelessWidget {
  final Store s;
  const CenterPage(this.s, {super.key});

  @override
  Widget build(BuildContext context) {
    return ListenableBuilder(
      listenable: s,
      builder: (context, _) {
        final logged =
            Cfg.ready && Supabase.instance.client.auth.currentUser != null;
        Widget step(bool ok, String t) => ListTile(
              dense: true,
              leading: Icon(ok ? Icons.check_circle : Icons.radio_button_unchecked,
                  color: ok ? Colors.green : null),
              title: Text(t),
            );
        void go(Widget w) =>
            Navigator.push(context, MaterialPageRoute(builder: (_) => w));
        Widget item(IconData i, String t, Widget w) => Card(
            child: ListTile(
                leading: Icon(i),
                title: Text(t),
                trailing: const Icon(Icons.chevron_left),
                onTap: () => go(w)));
        return subPage('سینٹر سیٹ اپ', [
          Card(
              child: Column(children: [
            step((s.profile['teacher'] ?? '').isNotEmpty, '1. سینٹر کا پروفائل'),
            step(s.batches.isNotEmpty, '2. بیچ / کلاسیں بنائیں'),
            step(s.students.isNotEmpty, '3. طلبہ شامل کریں'),
            step(logged, '4. "پیغامات" ٹیب میں لاگ اِن، تاکہ والدین ریکارڈ دیکھ سکیں'),
          ])),
          item(Icons.badge, 'سینٹر پروفائل', ProfilePage(s)),
          item(Icons.schedule, 'بیچ / کلاسیں اور اوقات', BatchesPage(s)),
          item(Icons.quiz, 'ٹیسٹ اور نمبر', TestsPage(s)),
          item(Icons.account_balance_wallet, 'حساب: آمدن اور خرچ', LedgerPage(s)),
        ]);
      },
    );
  }
}

class ProfilePage extends StatefulWidget {
  final Store s;
  const ProfilePage(this.s, {super.key});
  @override
  State<ProfilePage> createState() => _ProfilePageState();
}

class _ProfilePageState extends State<ProfilePage> {
  late final c = TextEditingController(text: widget.s.center);
  late final t = TextEditingController(text: widget.s.profile['teacher']);
  late final ph = TextEditingController(text: widget.s.profile['phone']);
  late final ci = TextEditingController(text: widget.s.profile['city']);
  late final sb = TextEditingController(text: widget.s.profile['sibling']);

  @override
  Widget build(BuildContext context) {
    final s = widget.s;
    return subPage('سینٹر پروفائل', [
      field(c, 'سینٹر / اکیڈمی کا نام'),
      field(t, 'ٹیچر کا نام'),
      field(ph, 'رابطہ نمبر', type: TextInputType.phone),
      field(ci, 'شہر / علاقہ'),
      field(sb, 'بھائی بہن کی رعایت % (ایک فون نمبر کے دوسرے بچوں پر)', type: TextInputType.number),
      FilledButton(
        onPressed: () {
          s.setCenter(c.text.trim());
          s.setProfile('teacher', t.text.trim());
          s.setProfile('phone', ph.text.trim());
          s.setProfile('city', ci.text.trim());
          s.setProfile('sibling', sb.text.trim());
          Navigator.pop(context);
        },
        child: const Text('محفوظ کریں'),
      ),
    ]);
  }
}

class BatchesPage extends StatefulWidget {
  final Store s;
  const BatchesPage(this.s, {super.key});
  @override
  State<BatchesPage> createState() => _BatchesPageState();
}

class _BatchesPageState extends State<BatchesPage> {
  final n = TextEditingController(),
      sub = TextEditingController(),
      tm = TextEditingController(),
      f = TextEditingController();

  @override
  Widget build(BuildContext context) {
    final s = widget.s;
    return ListenableBuilder(
      listenable: s,
      builder: (context, _) => subPage('بیچ / کلاسیں', [
        Card(
          child: Padding(
            padding: const EdgeInsets.all(12),
            child: Column(children: [
              field(n, 'بیچ کا نام (مثلاً نویں - صبح)'),
              field(sub, 'مضمون'),
              field(tm, 'وقت (مثلاً 4 سے 5 بجے، پیر تا جمعہ)'),
              field(f, 'ماہانہ فیس', type: TextInputType.number),
              SizedBox(
                width: double.infinity,
                child: FilledButton.icon(
                  icon: const Icon(Icons.add),
                  label: const Text('بیچ بنائیں'),
                  onPressed: () {
                    if (n.text.trim().isEmpty) return;
                    s.addBatch(n.text.trim(), sub.text.trim(), tm.text.trim(),
                        int.tryParse(f.text) ?? 0);
                    n.clear();
                    sub.clear();
                    tm.clear();
                    f.clear();
                  },
                ),
              ),
            ]),
          ),
        ),
        ...s.batches.map((b) => Card(
              child: ListTile(
                isThreeLine: true,
                title: Text('${b['name']}'),
                subtitle: Text(
                    '${b['subject']} · ${b['time']} · ${b['fee']} روپے\n${s.students.where((x) => x.batchId == b['id']).length} طلبہ'),
                trailing: IconButton(
                    icon: const Icon(Icons.delete_outline),
                    onPressed: () => s.delBatch(b['id'])),
              ),
            )),
      ]),
    );
  }
}

class TestsPage extends StatefulWidget {
  final Store s;
  const TestsPage(this.s, {super.key});
  @override
  State<TestsPage> createState() => _TestsPageState();
}

class _TestsPageState extends State<TestsPage> {
  final n = TextEditingController(), tot = TextEditingController();
  String batch = '';

  @override
  Widget build(BuildContext context) {
    final s = widget.s;
    return ListenableBuilder(
      listenable: s,
      builder: (context, _) => subPage('ٹیسٹ اور نمبر', [
        Card(
          child: Padding(
            padding: const EdgeInsets.all(12),
            child: Column(children: [
              field(n, 'ٹیسٹ کا نام (مثلاً ریاضی - ہفتہ وار)'),
              field(tot, 'کل نمبر', type: TextInputType.number),
              DropdownButton<String>(
                isExpanded: true,
                value: batch,
                items: [
                  const DropdownMenuItem(value: '', child: Text('سب طلبہ')),
                  ...s.batches.map((b) => DropdownMenuItem(
                      value: b['id'] as String, child: Text('${b['name']}'))),
                ],
                onChanged: (v) => setState(() => batch = v ?? ''),
              ),
              SizedBox(
                width: double.infinity,
                child: FilledButton.icon(
                  icon: const Icon(Icons.add),
                  label: const Text('ٹیسٹ بنائیں'),
                  onPressed: () {
                    if (n.text.trim().isEmpty) return;
                    s.addTest(n.text.trim(), int.tryParse(tot.text) ?? 100, batch);
                    n.clear();
                    tot.clear();
                  },
                ),
              ),
            ]),
          ),
        ),
        ...s.tests.reversed.map((x) => Card(
              child: ListTile(
                title: Text('${x['name']}'),
                subtitle: Text('${x['date']} · کل ${x['total']} · ${(x['marks'] as Map).length} کے نمبر لگے'),
                onTap: () => Navigator.push(
                    context,
                    MaterialPageRoute(
                        builder: (_) => MarksPage(s, x['id'] as String))),
                trailing: IconButton(
                    icon: const Icon(Icons.delete_outline),
                    onPressed: () => s.delTest(x['id'])),
              ),
            )),
      ]),
    );
  }
}

class MarksPage extends StatelessWidget {
  final Store s;
  final String tid;
  const MarksPage(this.s, this.tid, {super.key});

  @override
  Widget build(BuildContext context) {
    final t = s.tests.firstWhere((x) => x['id'] == tid);
    final list = s.students
        .where((x) => (t['batch'] ?? '') == '' || t['batch'] == x.batchId)
        .toList();
    return subPage('${t['name']} (کل ${t['total']})', [
      if (list.isEmpty) empty(),
      ...list.map((st) => Padding(
            padding: const EdgeInsets.only(bottom: 10),
            child: TextFormField(
              key: ValueKey('${tid}_${st.id}'),
              initialValue: ((t['marks'] as Map)[st.id] ?? '').toString(),
              keyboardType: TextInputType.number,
              decoration: InputDecoration(
                  labelText: st.name, border: const OutlineInputBorder()),
              onChanged: (v) => s.setMark(tid, st.id, num.tryParse(v)),
            ),
          )),
    ]);
  }
}

class LedgerPage extends StatefulWidget {
  final Store s;
  const LedgerPage(this.s, {super.key});
  @override
  State<LedgerPage> createState() => _LedgerPageState();
}

class _LedgerPageState extends State<LedgerPage> {
  final title = TextEditingController(), amt = TextEditingController();
  String type = 'out';

  @override
  Widget build(BuildContext context) {
    final s = widget.s;
    return ListenableBuilder(
      listenable: s,
      builder: (context, _) {
        final feeIn = s.receivedTotal();
        final rows =
            s.ledger.where((e) => '${e['d']}'.startsWith(s.month)).toList();
        int sum(String ty) => rows
            .where((e) => e['type'] == ty)
            .fold<int>(0, (a, e) => a + (e['amount'] as num).toInt());
        final oin = sum('in'), out = sum('out'), net = feeIn + oin - out;
        Widget box(String t, int v, Color c) => Expanded(
              child: Card(
                child: Padding(
                  padding: const EdgeInsets.all(10),
                  child: Column(children: [
                    Text(t, style: const TextStyle(fontSize: 12)),
                    Text('$v',
                        style: TextStyle(
                            fontSize: 20, fontWeight: FontWeight.bold, color: c)),
                  ]),
                ),
              ),
            );
        return subPage('حساب (${s.month})', [
          Row(children: [
            box('فیس وصول', feeIn, Colors.green.shade700),
            box('دیگر آمدن', oin, Colors.green.shade700),
          ]),
          Row(children: [
            box('خرچ', out, Colors.red.shade700),
            box('بچت', net, net >= 0 ? Colors.green.shade700 : Colors.red.shade700),
          ]),
          Card(
            child: Padding(
              padding: const EdgeInsets.all(12),
              child: Column(children: [
                DropdownButton<String>(
                  isExpanded: true,
                  value: type,
                  items: const [
                    DropdownMenuItem(value: 'out', child: Text('خرچ (کرایہ، بل، کتابیں...)')),
                    DropdownMenuItem(value: 'in', child: Text('دیگر آمدن (داخلہ فیس...)')),
                  ],
                  onChanged: (v) => setState(() => type = v ?? 'out'),
                ),
                field(title, 'تفصیل'),
                field(amt, 'رقم', type: TextInputType.number),
                SizedBox(
                  width: double.infinity,
                  child: FilledButton.icon(
                    icon: const Icon(Icons.add),
                    label: const Text('درج کریں'),
                    onPressed: () {
                      final a = int.tryParse(amt.text);
                      if (a == null || title.text.trim().isEmpty) return;
                      s.addLedger(type, title.text.trim(), a);
                      title.clear();
                      amt.clear();
                    },
                  ),
                ),
              ]),
            ),
          ),
          ...rows.reversed.map((e) => Card(
                child: ListTile(
                  title: Text('${e['title']}'),
                  subtitle: Text('${e['d']} · ${e['type'] == 'in' ? 'آمدن' : 'خرچ'}'),
                  leading: Text('${e['amount']}',
                      style: TextStyle(
                          fontWeight: FontWeight.bold,
                          color: e['type'] == 'in'
                              ? Colors.green.shade700
                              : Colors.red.shade700)),
                  trailing: IconButton(
                      icon: const Icon(Icons.delete_outline),
                      onPressed: () => s.delLedger(e['id'])),
                ),
              )),
        ]);
      },
    );
  }
}

// ---------------- والدین کے سوالات (ٹیچر) ----------------
class QuestionsPage extends StatefulWidget {
  final Store s;
  const QuestionsPage(this.s, {super.key});
  @override
  State<QuestionsPage> createState() => _QuestionsPageState();
}

class _QuestionsPageState extends State<QuestionsPage> {
  List<Map<String, dynamic>> rows = [];
  String msg = 'لوڈ ہو رہا ہے...';

  @override
  void initState() {
    super.initState();
    load();
  }

  Future<void> load() async {
    try {
      final r = await Supabase.instance.client
          .from('questions')
          .select('id,code,q,a,created_at')
          .order('created_at', ascending: false)
          .limit(50);
      setState(() {
        rows = List<Map<String, dynamic>>.from(r);
        msg = rows.isEmpty ? 'کوئی سوال نہیں' : '';
      });
    } catch (e) {
      setState(() => msg = 'خرابی (supabase_v3.sql چلائی؟): $e');
    }
  }

  String who(String code) {
    for (final st in widget.s.students) {
      if (st.code == code) return st.name;
    }
    return code;
  }

  Future<void> answer(Map<String, dynamic> r) async {
    final c = TextEditingController(text: (r['a'] as String?) ?? '');
    final ok = await showDialog<bool>(
      context: context,
      builder: (d) => AlertDialog(
        title: Text('${who(r['code'])}: ${r['q']}'),
        content: TextField(controller: c, maxLines: 3, autofocus: true),
        actions: [
          TextButton(
              onPressed: () => Navigator.pop(d, false),
              child: const Text('منسوخ')),
          TextButton(
              onPressed: () => Navigator.pop(d, true),
              child: const Text('جواب بھیجیں')),
        ],
      ),
    );
    if (ok == true && c.text.trim().isNotEmpty) {
      try {
        await Supabase.instance.client.from('questions').update({
          'a': c.text.trim(),
          'answered_at': DateTime.now().toUtc().toIso8601String(),
        }).eq('id', r['id']);
      } catch (_) {}
      load();
    }
  }

  @override
  Widget build(BuildContext context) {
    return subPage('والدین کے سوالات', [
      Row(children: [
        Expanded(child: Text(msg)),
        TextButton(onPressed: load, child: const Text('تازہ کریں')),
      ]),
      ...rows.map((r) => Card(
            child: ListTile(
              title: Text('${who(r['code'])}: ${r['q']}'),
              subtitle: Text(r['a'] == null ? 'جواب باقی ہے' : 'جواب: ${r['a']}'),
              trailing: Icon(r['a'] == null ? Icons.reply : Icons.check_circle,
                  color: r['a'] == null ? null : Colors.green),
              onTap: () => answer(r),
            ),
          )),
    ]);
  }
}

// ---------------- رپورٹ کارڈ اور فیس کی رسید (PDF) ----------------
class DocPage extends StatefulWidget {
  final Store s;
  final Student st;
  final bool receipt;
  const DocPage(this.s, this.st, {this.receipt = false, super.key});
  @override
  State<DocPage> createState() => _DocPageState();
}

class _DocPageState extends State<DocPage> {
  final key = GlobalKey();
  final remarks = TextEditingController();
  bool busy = false;

  // کارڈ کو تصویر بنا کر PDF میں ڈالتے ہیں تاکہ اردو بالکل درست شکل میں آئے
  Future<Uint8List> png() async {
    final b = key.currentContext!.findRenderObject() as RenderRepaintBoundary;
    final img = await b.toImage(pixelRatio: 3);
    final d = await img.toByteData(format: ui.ImageByteFormat.png);
    return d!.buffer.asUint8List();
  }

  Future<void> share() async {
    setState(() => busy = true);
    try {
      final im = pw.MemoryImage(await png());
      final doc = pw.Document();
      doc.addPage(pw.Page(
        pageFormat: PdfPageFormat.a4,
        margin: pw.EdgeInsets.zero,
        build: (c) => pw.Align(
            alignment: pw.Alignment.topCenter,
            child: pw.Image(im, fit: pw.BoxFit.fitWidth)),
      ));
      await Printing.sharePdf(
          bytes: await doc.save(),
          filename:
              '${widget.receipt ? "receipt" : "report"}_${widget.st.code}.pdf');
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context)
            .showSnackBar(SnackBar(content: Text('PDF نہیں بن سکا: $e')));
      }
    }
    if (mounted) setState(() => busy = false);
  }

  Widget kv(String k, String v, {bool bold = false}) => Padding(
        padding: const EdgeInsets.symmetric(vertical: 3),
        child: Row(children: [
          Expanded(child: Text(k)),
          Text(v,
              style: TextStyle(
                  fontWeight: bold ? FontWeight.bold : FontWeight.normal)),
        ]),
      );

  Widget card() {
    final s = widget.s, st = widget.st;
    final b = s.batchOf(st);
    final due = s.dueOf(st.id), rem = s.remaining(st.id);
    final teacher = s.profile['teacher'] ?? '';
    final phone = s.profile['phone'] ?? '';
    final city = s.profile['city'] ?? '';
    final info = [teacher, phone, city].where((x) => x.isNotEmpty).join(' · ');
    final tests = s.testsFor(st);
    var got = 0.0, tot = 0.0;
    for (final x in tests) {
      got += (x['got'] as num).toDouble();
      tot += (x['total'] as num).toDouble();
    }
    final marked = s.markedDays(st.id), present = s.presentDays(st.id);
    final no = 'R-${s.today.replaceAll("-", "")}-${st.code.substring(0, 4).toUpperCase()}';

    final rows = <Widget>[
      Text(s.center,
          textAlign: TextAlign.center,
          style: const TextStyle(
              fontSize: 26, fontWeight: FontWeight.bold, color: Color(0xFF0F7B5F))),
      if (info.isNotEmpty)
        Text(info, textAlign: TextAlign.center, style: const TextStyle(fontSize: 14)),
      const Divider(height: 24),
      Text(widget.receipt ? 'فیس کی رسید' : 'رپورٹ کارڈ',
          textAlign: TextAlign.center,
          style: const TextStyle(fontSize: 21, fontWeight: FontWeight.bold)),
      const SizedBox(height: 8),
      kv('نام', st.name, bold: true),
      if (b != null) kv('بیچ', '${b['name']}'),
      kv('مہینہ', s.month),
    ];
    if (widget.receipt) {
      rows.addAll([
        kv('رسید نمبر', no),
        const Divider(height: 24),
        kv('واجب فیس', '$due روپے'),
        kv('وصول شدہ', '${due - rem} روپے', bold: true),
        kv('باقی', '$rem روپے'),
        const SizedBox(height: 6),
        Text(rem == 0 ? 'فیس مکمل ادا ✅' : 'فیس جزوی ادا',
            textAlign: TextAlign.center,
            style: const TextStyle(fontSize: 19, fontWeight: FontWeight.bold)),
      ]);
    } else {
      rows.addAll([
        kv('حاضری',
            marked == 0 ? '-' : '$present / $marked دن (${(present * 100 / marked).round()}%)'),
        if (tests.isNotEmpty) ...[
          const Divider(height: 24),
          const Text('ٹیسٹ کے نتائج', style: TextStyle(fontWeight: FontWeight.bold)),
          ...tests.map((x) {
            final tt = (x['total'] as num).toDouble();
            final pc = tt == 0 ? 0 : ((x['got'] as num) * 100 / tt).round();
            return kv('${x['name']}', '${x['got']} / ${x['total']}  ($pc%)');
          }),
          if (tot > 0) kv('اوسط', '${(got * 100 / tot).round()}%', bold: true),
        ],
        const Divider(height: 24),
        kv('فیس', rem == 0 ? 'ادا ✅' : 'باقی $rem روپے'),
        if (remarks.text.trim().isNotEmpty) ...[
          const SizedBox(height: 8),
          const Text('ٹیچر کے ریمارکس', style: TextStyle(fontWeight: FontWeight.bold)),
          Text(remarks.text.trim()),
        ],
      ]);
    }
    rows.addAll([
      const Divider(height: 28),
      kv('تاریخ', s.today),
      const SizedBox(height: 28),
      const Text('ٹیچر کے دستخط: ______________'),
    ]);

    return Theme(
      data: ThemeData.light(useMaterial3: true),
      child: Container(
        width: 595,
        color: Colors.white,
        padding: const EdgeInsets.all(28),
        child: DefaultTextStyle(
          style: const TextStyle(color: Colors.black, fontSize: 17, height: 1.8),
          child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: rows),
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text(widget.receipt ? 'فیس کی رسید' : 'رپورٹ کارڈ')),
      body: SafeArea(
        child: ListView(padding: const EdgeInsets.all(12), children: [
          if (!widget.receipt)
            TextField(
              controller: remarks,
              maxLines: 2,
              onChanged: (_) => setState(() {}),
              decoration: const InputDecoration(
                  labelText: 'ٹیچر کے ریمارکس (اختیاری)',
                  border: OutlineInputBorder()),
            ),
          const SizedBox(height: 12),
          FittedBox(
              fit: BoxFit.fitWidth,
              child: RepaintBoundary(key: key, child: card())),
          const SizedBox(height: 12),
          FilledButton.icon(
            icon: const Icon(Icons.share),
            label: Text(busy ? '...' : 'PDF شیئر کریں (واٹس ایپ)'),
            onPressed: busy ? null : share,
          ),
        ]),
      ),
    );
  }
}
